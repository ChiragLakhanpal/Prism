#!/bin/sh
# Installs what Prism needs to run and to pass its gate, then turns the gate on.
# Run it once after cloning, and again in each new worktree, from anywhere in the repo:
#
#     scripts/install
#
# It needs the network to download packages and the test browser. The gate never does.
set -eu
cd "$(git rev-parse --show-toplevel)"

echo "Installing Python 3.12 and the Python packages with uv."
uv python install 3.12
uv sync --frozen

echo "Installing the web app's packages with npm."
npm --prefix web ci --no-audit --no-fund

echo "Installing the Chromium browser for the Playwright tests."
(cd web && npx playwright install chromium)

echo "Turning on the gate. Git will run it before every commit and every merge commit."
git config core.hooksPath .githooks

echo "Prism is installed. Run the gate with .githooks/pre-commit, and start the app with scripts/dev."
