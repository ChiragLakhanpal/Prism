{
  "name": "strata-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "build:gallery": "vite build --mode gallery --outDir dist-gallery --emptyOutDir",
    "capture": "npm run build && npm run build:gallery && playwright test --config playwright.capture.config.ts"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@radix-ui/react-popover": "1.3.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
