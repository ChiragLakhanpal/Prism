{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "../fairshare"
    ],
    "allow": [
      "Agent(isolation:worktree)",
      "Bash(git *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(which *)",
      "Bash(source *)",
      "Bash(set *)",
      "Bash(lsof *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(duckdb *)",
      "Bash(databricks *)",
      "Bash(curl *)",
      "Bash(.githooks/pre-commit)",
      "Bash(bash .githooks/pre-commit)",
      "WebSearch",
      "WebFetch(domain:docs.databricks.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:search.worldbank.org)",
      "WebFetch(domain:datacatalogapi.worldbank.org)",
      "WebFetch(domain:api.worldbank.org)",
      "WebFetch(domain:documents.worldbank.org)",
      "WebFetch(domain:documents1.worldbank.org)",
      "WebFetch(domain:projects.worldbank.org)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
