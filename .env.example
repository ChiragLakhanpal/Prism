# Copy to .env and fill in. Nothing in .env is committed.
# The P0 credentials ticket walks through every value with the wizard skill.

# Databricks Free Edition (shared with fairshare; Strata uses its own catalog, strata, named in bundle/catalog.yml)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Or, when a token cannot be made, a service principal:
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_ID=
GENIE_SPACE_ID=
AI_SEARCH_ENDPOINT=

# Microsoft Foundry and Azure OpenAI (resource group WorldBank-demo, resource wb-strata)
FOUNDRY_PROJECT_ENDPOINT=https://wb-strata.services.ai.azure.com/api/projects/Strata
FOUNDRY_TENANT_ID=
# The Entra app registration the Databricks App reaches the Foundry agent as. It needs the Azure AI User role
# on the Foundry resource where that role exists, otherwise Cognitive Services User (Azure AI Developer lacks
# the agents data action; checked on October 26, 2026). The wizard does not make it yet, so the two lines stay commented until you fill them;
# without both, the deployed app has no agent.
# FOUNDRY_CLIENT_ID=
# FOUNDRY_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=https://wb-strata.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# The four model deployments are named in config/models.toml, not here.

# Traces for the Foundry agent
APPLICATIONINSIGHTS_CONNECTION_STRING=
