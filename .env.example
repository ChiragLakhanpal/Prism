# Copy to .env and fill in. Nothing in .env is committed.
# The P0 credentials ticket walks through every value with the wizard skill.

# Databricks Free Edition (shared with fairshare; Strata uses its own catalog)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
STRATA_CATALOG=strata
GENIE_SPACE_ID=
AI_SEARCH_ENDPOINT=

# Microsoft Foundry and Azure OpenAI (resource group WorldBank-demo, resource wb-strata)
FOUNDRY_PROJECT_ENDPOINT=https://wb-strata.services.ai.azure.com/api/projects/Strata
FOUNDRY_TENANT_ID=
AZURE_OPENAI_ENDPOINT=https://wb-strata.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
STRATA_MODEL_AGENT=gpt-5.4-mini
STRATA_MODEL_DRAFT=gpt-5.4
STRATA_MODEL_BATCH=gpt-5.4-nano
STRATA_MODEL_EMBED=text-embedding-3-large

# Traces for the Foundry agent
APPLICATIONINSIGHTS_CONNECTION_STRING=
