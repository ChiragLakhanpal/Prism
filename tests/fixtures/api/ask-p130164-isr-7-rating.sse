data: {"id": "strata.gold.passage:31525018/v1/78", "kind": "passage", "tool": "get_disagreements", "stratum": "Why", "short_name": "ICR", "row": {"assertion_id": "strata.gold.passage:31525018/v1/78#P130164/pdo_progress", "evidence_id": "strata.gold.passage:31525018/v1/78", "project_id": "P130164", "source": {"document_type": "Implementation Completion and Results Report", "project_id": "P130164", "project_name": "Rajasthan Road Sector Modernization Project", "document_id": "31525018", "document_date": "2019-10-10", "report_number": "ICR4803", "version": 1, "section_path": "IV.C", "paragraph": "78", "paragraph_numbered": true, "pdf_page": 27, "pdf_pages": 66, "pdf_url": "https://documents.worldbank.org/curated/en/258481572631321132/pdf/India-Rajasthan-Road-Sector-Modernization-Project.pdf", "doc_key": "icr-2019-10-10", "notice_id": null, "notice_url": null}, "evidence_tier": "icr", "form": "narrative", "source_key": "documents", "document_id": "31525018", "document_type": "Implementation Completion and Results Report", "report_number": "ICR4803", "version": 1, "sequence": null, "passage_id": "31525018/v1/78", "pdf_page": 27, "paragraph": "78", "paragraph_numbered": true, "printed_page": "23 of 62", "doc_key": "icr-2019-10-10", "section_path": "IV.C", "language": "en", "kind": "paragraph", "text": "78. Nevertheless, one may question why it had been decided to pursue the implementation of Components 2 and 3 without modifying the scope of these components, changing the PDO, or extending the project implementation period, considering the assessment made during the MTR. Indeed, it was clearly identified at the MTR that the achievement of part of the PDO was compromised by the major delays in implementing activities under Components 2 and 3 and lack of endorsement from relevant stakeholders.", "text_left_out": null, "field_name": "achievement of part of the PDO", "value": "unsatisfactory", "value_form": "judgment", "judgment": "unsatisfactory", "quote": "it was clearly identified at the MTR that the achievement of part of the PDO was compromised", "period_start": "2016-05-16", "period_end": "2016-05-16", "made_at": "2019-10-10", "public_from": "2019-11-02", "months_after_event": 40}, "highlights": [{"sentence": 0, "start": 281, "end": 373}], "feedback": {"allowed": false, "why_not": "no_question", "run_id": "run-0001", "mode": "pilot", "my_report": null, "limits": {"reason_max_chars": 500}}}

