event: sentence
data: {"index": 0, "text": "Where an earlier status report had rated progress towards the project development objective (PDO) well, the completion report later said \"it was clearly identified at the MTR that the achievement of part of the PDO was compromised\".", "kind": "quote", "evidence_ids": ["strata.gold.passage:31525018/v1/78", "strata.gold.passage:26733307/v1/s4"], "numbers": [], "dates": [], "quote": {"text": "it was clearly identified at the MTR that the achievement of part of the PDO was compromised", "evidence_id": "strata.gold.passage:31525018/v1/78"}}

event: evidence
data: {"id": "strata.gold.passage:31525018/v1/78", "kind": "passage", "tool": "get_disagreements", "stratum": "Why", "short_name": "ICR", "row": {"evidence_id": "strata.gold.passage:31525018/v1/78", "public_from": "2019-11-02", "source": {"document_type": "Implementation Completion and Results Report", "project_id": "P130164", "project_name": "Rajasthan Road Sector Modernization Project", "document_id": "31525018", "document_date": "2019-10-10", "report_number": "ICR4803", "version": 1, "section_path": "IV.C", "paragraph": "78", "paragraph_numbered": true, "pdf_page": 27, "pdf_pages": 66, "pdf_url": "http://documents.worldbank.org/curated/en/258481572631321132/pdf/India-Rajasthan-Road-Sector-Modernization-Project.pdf", "doc_key": "icr-2019-10-10", "notice_id": null, "notice_url": null}, "passage_id": "31525018/v1/78", "document_id": "31525018", "document_type": "Implementation Completion and Results Report", "project_id": "P130164", "version": 1, "section_path": "IV.C", "paragraph": "78", "paragraph_numbered": true, "part": 1, "parts": 1, "pdf_page": 27, "last_pdf_page": 27, "printed_page": "23 of 62", "language": "en", "parse_route": "A", "kind": "paragraph", "route": "published_text", "scanned": false, "table_title": null, "table_row": null, "cells": null, "notice_id": null, "header": "ICR, P130164, India, roads, IV.C, ¶78, p.27", "text": "78. Nevertheless, one may question why it had been decided to pursue the implementation of Components 2 and 3 without modifying the scope of these components, changing the PDO, or extending the project implementation period, considering the assessment made during the MTR. Indeed, it was clearly identified at the MTR that the achievement of part of the PDO was compromised by the major delays in implementing activities under Components 2 and 3 and lack of endorsement from relevant stakeholders.", "also": [{"assertion_id": "strata.gold.passage:31525018/v1/78#P130164/pdo_progress", "evidence_id": "strata.gold.passage:31525018/v1/78", "evidence_tier": "icr", "form": "narrative", "source_key": "documents", "document_id": "31525018", "document_type": "Implementation Completion and Results Report", "report_number": "ICR4803", "version": 1, "sequence": null, "passage_id": "31525018/v1/78", "pdf_page": 27, "paragraph": "78", "paragraph_numbered": true, "printed_page": "23 of 62", "doc_key": "icr-2019-10-10", "text": "78. Nevertheless, one may question why it had been decided to pursue the implementation of Components 2 and 3 without modifying the scope of these components, changing the PDO, or extending the project implementation period, considering the assessment made during the MTR. Indeed, it was clearly identified at the MTR that the achievement of part of the PDO was compromised by the major delays in implementing activities under Components 2 and 3 and lack of endorsement from relevant stakeholders.", "field_name": "achievement of part of the PDO", "value": "unsatisfactory", "value_form": "judgment", "judgment": "unsatisfactory", "quote": "it was clearly identified at the MTR that the achievement of part of the PDO was compromised", "period_start": "2016-05-16", "period_end": "2016-05-16", "made_at": "2019-10-10", "public_from": "2019-11-02", "months_after_event": 40}]}, "highlights": [{"sentence": 0, "start": 281, "end": 373}], "feedback": {"allowed": false, "why_not": "no_question", "run_id": "run-0001", "mode": "pilot", "my_report": null, "limits": {"reason_max_chars": 500}}}

