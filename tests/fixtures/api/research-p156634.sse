event: evidence
data: {"id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4", "public_from": "2026-06-30", "source": {"key": "isr_narrative", "label": "World Bank project reports", "kind": "bank_report", "license": "The World Bank: Documents & Reports (documents.worldbank.org). License: CC BY 4.0.", "url_of_source": "https://documents.worldbank.org/en/publication/documents-reports/documentlist?projid=P156634&docty_exact=Implementation+Status+and+Results+Report"}, "kind": "bank_report", "title": "ISR ISR07733, June 30, 2026: Implementation Status and Key Decisions, page 2", "text": "The Project is making steady overall progress across its components. In the coastal region, bulk water supply capacity has been significantly enhanced through the rehabilitation of the Baricho water supply system, adding 36,000m³/day of supply capacity to Kilifi and Mombasa counties. Solarization of the Baricho bulk water system is complete and expected to deliver substantial energy cost savings estimated at Kshs 10 million per month. Water distribution and sanitation contracts are advancing well, with most works either completed or nearing completion. Sanitation infrastructure, including ablution blocks, sewer networks, and fecal sludge treatment plants, is largely on track. In the northeastern counties, rehabilitation and construction of boreholes and sanitation facilities in Garissa and Wajir are substantially complete or nearing finalization, and long-term water supply planning for Wajir county is advancing with key technical and hydrogeological deliverables are being finalized. At the national level, the Conditional Liquidity Support Grant is rolling out activities aimed at supporting the financial recovery of Water Service Providers. The Utility Turnaround Framework has supported tariff reviews and institutional strengthening across coastal and northeastern WSPs, while project management and technical assistance arrangements continue to provide effective oversight and coordination across all components.", "url": "https://documents.worldbank.org/curated/en/099063026170036715/pdf/P156634-a6497888-50b9-45b4-88d2-1303b0327745.pdf#page=2", "published": "2026-06-30", "date_known": true, "observed": null, "location": null, "image_urls": [], "author": "World Bank", "read_on": "2026-11-05", "team": null, "notice": null}, "highlights": []}

