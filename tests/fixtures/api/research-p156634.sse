data: {"id": "strata.tools.research_evidence:P156634@2026-11-05", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.tools.research_evidence:P156634@2026-11-05", "public_from": "2026-11-05", "source": {"tool": "research_evidence", "sources": ["documents", "notices", "projects"]}, "items_total": 60, "counts_by_kind": {"agency_statement": 28, "bank_report": 7, "news": 14, "procurement": 7, "satellite": 1, "site_condition": 3}, "closing_date": "2026-10-31", "late_award_days": 110, "awards_in_window": 6, "direct_awards_in_window": 2, "last_award_date": "2026-10-13", "days_from_last_award_to_closing": 18, "suppliers_checked": null, "suppliers_sanctioned": null, "sources_reached": [{"key": "isr_narrative", "label": "World Bank project reports", "kind": "bank_report", "status": "read", "note": "Prism read 10 passages of the 2 newest ISRs, of June 30, 2026 and March 12, 2026.", "items": 7}, {"key": "procurement_notices", "label": "World Bank procurement notices", "kind": "procurement", "status": "read", "note": "Prism read 7 contract awards and invitations for bids published from May 9, 2026 to November 5, 2026.", "items": 7}, {"key": "outlet_feeds", "label": "News outlets' feeds", "kind": "news", "status": "200", "note": "Prism read 7 of 8 feeds and kept 0 entries that name the project, its agencies or its places. The Star's feed address answered a web page, not a feed. Of the pages the sample cites, Eastleigh Voice's page answered a bot check page, so the headline stands in for the article.", "items": 14}, {"key": "inspection_panel", "label": "World Bank Inspection Panel", "kind": "complaint", "status": "200", "note": "The Inspection Panel's register lists 197 cases, 0 of them naming P156634.", "items": 0}, {"key": "sentinel2_mosaic", "label": "Sentinel-2 cloudless mosaics", "kind": "satellite", "status": "read", "note": "Prism built the tile addresses of the 2018 and 2025 mosaics for 18 locations and fetched no tile.", "items": 1}, {"key": "mastodon", "label": "Mastodon", "kind": "social", "status": "200", "note": "Prism read 19 tag timelines and kept 5 posts that name a project place or agency together with a sector word.", "items": 0}, {"key": "site_conditions", "label": "GDACS disaster alerts", "kind": "site_condition", "status": "200", "note": "GDACS lists 3 events for Kenya in the window, 3 of them naming it.", "items": 3}, {"key": "agency_statements", "label": "The implementing agencies' own news pages", "kind": "agency_statement", "status": "200", "note": "Prism read the news pages of NWWDA, CWWDA, KWAWASCO and kept 28 entries.", "items": 28}], "sources_not_reached": [{"key": "gdelt_news", "label": "GDELT", "kind": "news", "status": "429", "note": "GDELT limited calls from this network."}, {"key": "sanctions", "label": "World Bank listing of ineligible firms and individuals", "kind": "sanctions", "status": "no list", "note": "The sanctions check did not run: the list needs a download from the page."}]}, "highlights": []}

event: evidence
data: {"id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835", "public_from": "2022-10-28", "source": {"key": "outlet_feeds", "label": "News outlets' feeds", "kind": "news", "license": "Each article belongs to its outlet; Prism keeps its words with a link to the article, for reference.", "url_of_source": "https://www.the-star.co.ke/rss/news"}, "kind": "news", "title": "Mombasa residents protest over sewerage renovation payout delays", "text": "At least 270 people have been affected by the multi-million sewage project\n\nRepresentatives of the Old Town community stormed the Mombasa Water Supply and Sanitation Company offices over delayed compensation for residents affected by sewerage line renovation.\n\nThey were accompanied by the Muslims for Human Rights (Muhuri) organisation on Thursday.\n\nLed by Lubnar Omar, the representatives said they wanted their disturbance allowance soon because the renovations had affected their businesses, which led to temporary closures.\n\nAt least 270 people have been affected by the project.\n\n\"The project is good but it disrupted our businesses because of the construction works. In addition, the old pipes spill sewage all over the place,\" Omar said.\n\n\"Muhuri worked with this office (Mombasa Water) to identify and map the affected people in this project,\" Francis Auma, Muhuri's rapid response officer said.\n\n\"It's now more than a month since the listing yet the community members remain confused by the delay in releasing the compensation , which is their right.\"\n\nThe World Bank, through Mowasco, in August started renovations of the water supply and sewerage lines at Old Town to protect and preserve its heritage, a primary tourist attraction site.\n\nOmar said the repairs at Old Town also caused dirt and sewage to spill over to their houses, putting their health at risk.\n\nOn August 23, 2022, Muhuri held a meeting with Mowasco and the representatives of the affected people to mediate over the disputed amount which the company would pay in compensation.\n\nDuring the meeting, the two parties settled on Sh6,000 as the amount that every business affected would get.\n\nIn another meeting held on September 1, the affected people met with the water company and were issued award letters for compensation.\n\nIn the meeting, Muhuri's correspondence shows the company agreed to use water bowsers to sprinkle water twice a day to manage the dust caused by the project.\n\nNone of the items that were decided have been implemented yet, according to the lobby and the representatives of the Old Town community.\n\nAuma and community leaders accused Mowasco of holding back their money illegally and said they would camp at their offices until their issues are resolved.\n\nMark Mwambota, the company's project engineer, tried to calm them down in vain.\n\nThey demanded assurance from the company's managing director Abdirahim Farah, who was not in the office.\n\nHowever, the Mowasco boss later addressed the agitated group via a phone call made through Mwambota.\n\nHe promised that all the 270 affected people would get their money by November 22.", "url": "https://www.the-star.co.ke/news/2022-10-28-mombasa-residents-protest-over-sewerage-renovation-payout-delays", "published": "2022-10-28", "date_known": true, "observed": null, "location": {"geo_loc_id": "186298", "name": "Mombasa", "latitude": -4.02, "longitude": 39.66667}, "image_urls": [], "author": "The Star", "read_on": "2026-11-05", "team": null, "notice": null}, "highlights": []}

