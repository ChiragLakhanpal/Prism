event: sentence
data: {"index": 0, "text": "In the last months before its closing date, the project's Baricho works on the coast were finishing while contracts were still being awarded, and residents in Mombasa had pushed back on its works.", "kind": "summary", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40114539-p2-s4", "strata.tools.research_evidence:P156634@2026-11-05", "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835", "strata.research.item:P156634/outlet_feeds/a230f243be70415c"], "numbers": [], "dates": [], "quote": null, "section": "headline", "group": null, "part": "sentence"}

event: sentence
data: {"index": 1, "text": "The Baricho solar plant, financed under the project at Sh670 million, was 60 percent complete in January 2026 and 90 per cent complete in March 2026, and the World Bank's report of June 30, 2026 says its solarization is complete, with savings estimated at Kshs 10 million per month.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/595f89b9956ceda3", "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb", "strata.research.item:P156634/outlet_feeds/df117621dfc94a93", "strata.research.item:P156634/isr_narrative/40114539-p2-s4"], "numbers": [{"text": "670", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}, {"text": "60", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}, {"text": "90", "evidence_id": "strata.research.item:P156634/outlet_feeds/df117621dfc94a93"}, {"text": "10", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}], "dates": [{"text": "January 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}, {"text": "March 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}, {"text": "June 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4"}], "quote": null, "section": "picture", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 2, "text": "The agency is seeking additional partners and donors for phase two, which will extend solar-powered water pumping to Mombasa County.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"], "numbers": [{"text": "two", "evidence_id": "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"}], "dates": [], "quote": null, "section": "picture", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 3, "text": "In Wajir, the faecal sludge treatment plant meant to end the town's bucket toilets was 64% complete on June 4, 2026, when the Water and Sanitation Secretary urged the contractor and project consultant to accelerate construction works.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/e25eedf42e385947"], "numbers": [{"text": "64", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}], "dates": [{"text": "June 4, 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}], "quote": null, "section": "picture", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 4, "text": "Between July 15, 2026 and October 13, 2026, the project's agencies published six contract awards in the 110 days before the closing date, two of them by direct selection, the last 18 days before closing.", "kind": "record", "evidence_ids": ["strata.tools.research_evidence:P156634@2026-11-05", "strata.research.item:P156634/procurement_notices/OP00456907", "strata.research.item:P156634/procurement_notices/OP00474946"], "numbers": [{"text": "six", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}, {"text": "110", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}, {"text": "two", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}, {"text": "18", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "dates": [{"text": "July 15, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00456907"}, {"text": "October 13, 2026", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "quote": null, "section": "picture", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 5, "text": "In Mombasa, Old Town traders stormed the water company's offices in October 2022 over delayed disturbance allowances, and Mwembe Tayari residents voiced outrage over job promises and disruptions.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835", "strata.research.item:P156634/outlet_feeds/a230f243be70415c"], "numbers": [], "dates": [{"text": "October 2022", "evidence_id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"}], "quote": null, "section": "picture", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 6, "text": "The Kipevu wastewater plant, which was being rehabilitated at Sh280 million in May 2022, was still under rehabilitation in the World Bank's data of January 30, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b", "strata.research.item:P156634/isr_narrative/40091292-p6-s7"], "numbers": [{"text": "280", "evidence_id": "strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b"}], "dates": [{"text": "May 2022", "evidence_id": "strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b"}, {"text": "January 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p6-s7"}], "quote": null, "section": "picture", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 7, "text": "With six contracts awarded in the 110 days before closing, two by direct selection, check each contract's completion date against the closing date of October 31, 2026.", "kind": "advice", "evidence_ids": ["strata.tools.research_evidence:P156634@2026-11-05"], "numbers": [{"text": "six", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}, {"text": "110", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}, {"text": "two", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "dates": [{"text": "October 31, 2026", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "quote": null, "section": "bottom_line", "group": null, "part": "sentence"}

event: sentence
data: {"index": 8, "text": "The Kipevu plant was still under rehabilitation in January 2026, years after it was due, so ask for its extensions of time and the date it will be taken over.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b", "strata.research.item:P156634/isr_narrative/40091292-p6-s7"], "numbers": [], "dates": [{"text": "January 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p6-s7"}], "quote": null, "section": "bottom_line", "group": null, "part": "sentence"}

event: sentence
data: {"index": 9, "text": "The Old Town agreements on disturbance allowances and dust control are where residents have protested before, so ask the Mombasa water company what has been paid and done.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"], "numbers": [], "dates": [], "quote": null, "section": "bottom_line", "group": null, "part": "sentence"}

event: sentence
data: {"index": 10, "text": "The award for equipping the Sarman - Tarbaj boreholes, Lot 1, was published on October 13, 2026, a day after the invitation for bids for the same works and 18 days before the closing date.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00474946", "strata.research.item:P156634/procurement_notices/OP00474700", "strata.tools.research_evidence:P156634@2026-11-05"], "numbers": [{"text": "1", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00474946"}, {"text": "18", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "dates": [{"text": "October 13, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00474946"}], "quote": null, "section": "developments", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 11, "text": "The award for equipping the Qaras boreholes, Lot 3, was published on October 12, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00474696"], "numbers": [{"text": "3", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00474696"}], "dates": [{"text": "October 12, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00474696"}], "quote": null, "section": "developments", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 12, "text": "A civil society lobby demanded a solution to the Changamwe-Jomvu water crisis in Mombasa on October 8, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/b87138d428e8a344"], "numbers": [], "dates": [{"text": "October 8, 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/b87138d428e8a344"}], "quote": null, "section": "developments", "group": 2, "part": "sentence"}

event: sentence
data: {"index": 13, "text": "The solar system for the Ukunda water supply was awarded by direct selection on September 25, 2026, for KES 314838645.42.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00471125"], "numbers": [{"text": "314838645.42", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00471125"}], "dates": [{"text": "September 25, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00471125"}], "quote": null, "section": "developments", "group": 3, "part": "sentence"}

event: sentence
data: {"index": 14, "text": "The supply and installation of additional pumps at Baricho was awarded on September 4, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00466974"], "numbers": [], "dates": [{"text": "September 4, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00466974"}], "quote": null, "section": "developments", "group": 4, "part": "sentence"}

event: sentence
data: {"index": 15, "text": "The Vindo booster station works were awarded by direct selection on July 20, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00457686"], "numbers": [], "dates": [{"text": "July 20, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00457686"}], "quote": null, "section": "developments", "group": 5, "part": "sentence"}

event: sentence
data: {"index": 16, "text": "The equipping of the Nurgows boreholes, Lot 2, was awarded on July 15, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00456907"], "numbers": [{"text": "2", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00456907"}], "dates": [{"text": "July 15, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00456907"}], "quote": null, "section": "developments", "group": 6, "part": "sentence"}

event: sentence
data: {"index": 17, "text": "The World Bank's report of June 30, 2026 says the Baricho rehabilitation added 36,000m³/day of supply capacity to Kilifi and Mombasa counties, and that the Garissa and Wajir boreholes and sanitation facilities are \"substantially complete or nearing finalization\".", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40114539-p2-s4"], "numbers": [{"text": "36,000", "evidence_id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4"}], "dates": [{"text": "June 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4"}], "quote": null, "section": "developments", "group": 7, "part": "sentence"}

event: sentence
data: {"index": 18, "text": "The Wajir faecal sludge treatment plant was 64% complete, and the Water and Sanitation Secretary urged the contractor and project consultant to accelerate construction works.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/e25eedf42e385947"], "numbers": [{"text": "64", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}], "dates": [], "quote": null, "section": "developments", "group": 8, "part": "sentence"}

event: sentence
data: {"index": 19, "text": "The World Bank approved the Coastal Region Water Security and Climate Resilience Project (P513697) on March 20, 2026, to increase bulk water supply to Mombasa County and Kwale County.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/record-P513697"], "numbers": [], "dates": [{"text": "March 20, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/record-P513697"}], "quote": null, "section": "developments", "group": 9, "part": "sentence"}

event: sentence
data: {"index": 20, "text": "Inspecting Baricho, the Cabinet Secretary said the solar project was at 90 per cent complete, with 6,716 solar panels installed.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/df117621dfc94a93"], "numbers": [{"text": "90", "evidence_id": "strata.research.item:P156634/outlet_feeds/df117621dfc94a93"}, {"text": "6,716", "evidence_id": "strata.research.item:P156634/outlet_feeds/df117621dfc94a93"}], "dates": [], "quote": null, "section": "developments", "group": 10, "part": "sentence"}

event: sentence
data: {"index": 21, "text": "The World Bank's report of March 12, 2026 put overall physical progress of works contracts at 85 percent, with 46 percent of works contracts and all goods contracts completed.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p2-s4"], "numbers": [{"text": "85", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p2-s4"}, {"text": "46", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p2-s4"}], "dates": [{"text": "March 12, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p2-s4"}], "quote": null, "section": "developments", "group": 10, "part": "sentence"}

event: sentence
data: {"index": 22, "text": "The Baricho solar plant, begun in October 2025 and due by March 31, 2026, was 60 percent complete, and the agency paid about Sh60 million a month for power.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/595f89b9956ceda3", "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"], "numbers": [{"text": "60", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}, {"text": "60", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}], "dates": [{"text": "October 2025", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}, {"text": "March 31, 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/595f89b9956ceda3"}], "quote": null, "section": "developments", "group": 11, "part": "sentence"}

event: sentence
data: {"index": 23, "text": "Launching the Northern Water Works Development Agency's plan for 2024 to 2028, the Cabinet Secretary said the ministry had invested more than Sh12 billion in the region.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"], "numbers": [{"text": "12", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}], "dates": [{"text": "2024", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}, {"text": "2028", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}], "quote": null, "section": "developments", "group": 12, "part": "sentence"}

event: sentence
data: {"index": 24, "text": "The Governor of Taita Taveta called for the Coast Water Works Development Agency to be disbanded for failing to supply water to the region.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/c1f6a8f12b71bd4a"], "numbers": [], "dates": [], "quote": null, "section": "developments", "group": 13, "part": "sentence"}

event: sentence
data: {"index": 25, "text": "People Daily reported that a report by the Auditor General named the Coast Water Works Development Agency \"the most incompetent agency in the water sector with almost all the projects delayed in implementation\".", "kind": "quote", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/57eebce979ca2f45"], "numbers": [], "dates": [], "quote": {"text": "the most incompetent agency in the water sector with almost all the projects delayed in implementation", "evidence_id": "strata.research.item:P156634/outlet_feeds/57eebce979ca2f45"}, "section": "developments", "group": 14, "part": "sentence"}

event: sentence
data: {"index": 26, "text": "The government announced the Sh4 billion Baricho water works complete, with three boreholes destroyed by floods in 2018 rehabilitated and the Baricho-Kakuyuni pipeline done for Sh2 billion.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"], "numbers": [{"text": "4", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}, {"text": "three", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}, {"text": "2", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}], "dates": [{"text": "2018", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}], "quote": null, "section": "developments", "group": 15, "part": "sentence"}

event: sentence
data: {"index": 27, "text": "Old Town representatives stormed the Mombasa Water Supply and Sanitation Company offices over delayed compensation, with at least 270 people affected and Sh6,000 settled as the amount each business would get.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"], "numbers": [{"text": "270", "evidence_id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"}, {"text": "6,000", "evidence_id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"}], "dates": [], "quote": null, "section": "developments", "group": 16, "part": "sentence"}

event: sentence
data: {"index": 28, "text": "The Kipevu wastewater treatment plant, constructed in 1980, was being rehabilitated at Sh280 million and \"is expected to be done by October this year\".", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b"], "numbers": [{"text": "280", "evidence_id": "strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b"}], "dates": [{"text": "1980", "evidence_id": "strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b"}], "quote": null, "section": "developments", "group": 17, "part": "sentence"}

event: sentence
data: {"index": 29, "text": "Mwembe Tayari residents voiced outrage over job promises and disruptions from a Mombasa water project.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/a230f243be70415c"], "numbers": [], "dates": [], "quote": null, "section": "developments", "group": 18, "part": "sentence"}

event: sentence
data: {"index": 30, "text": "On the coast, the Baricho works were finishing.", "kind": "summary", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40114539-p2-s4", "strata.research.item:P156634/outlet_feeds/df117621dfc94a93", "strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025"], "numbers": [], "dates": [], "quote": null, "section": "by_site", "group": 0, "part": "title"}

event: sentence
data: {"index": 31, "text": "The project rehabilitated the Baricho water supply system, adding 36,000m³/day of supply capacity to Kilifi and Mombasa counties.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40114539-p2-s4"], "numbers": [{"text": "36,000", "evidence_id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4"}], "dates": [], "quote": null, "section": "by_site", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 32, "text": "The ministry announced the Sh4 billion Baricho water works complete in June 2024.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"], "numbers": [{"text": "4", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}], "dates": [{"text": "June 2024", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}], "quote": null, "section": "by_site", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 33, "text": "The solar plant of 4.6 megawatts on the 11 boreholes was financed at Sh670 million, and the agency expects to save at least Sh10 million per month in power bills.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"], "numbers": [{"text": "4.6", "evidence_id": "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"}, {"text": "11", "evidence_id": "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"}, {"text": "670", "evidence_id": "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"}, {"text": "10", "evidence_id": "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"}], "dates": [], "quote": null, "section": "by_site", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 34, "text": "Additional pumps for Baricho were awarded on September 4, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00466974"], "numbers": [], "dates": [{"text": "September 4, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00466974"}], "quote": null, "section": "by_site", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 35, "text": "People Daily reported in November 2024 that the Auditor General found the Baricho Well-Field Protection Works, allocated Sh 3.6 billion in 2021, still in progress.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/57eebce979ca2f45"], "numbers": [{"text": "3.6", "evidence_id": "strata.research.item:P156634/outlet_feeds/57eebce979ca2f45"}], "dates": [{"text": "November 2024", "evidence_id": "strata.research.item:P156634/outlet_feeds/57eebce979ca2f45"}, {"text": "2021", "evidence_id": "strata.research.item:P156634/outlet_feeds/57eebce979ca2f45"}], "quote": null, "section": "by_site", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 36, "text": "The Sentinel-2 cloudless mosaics of 2018 and 2025 around Baricho Sub-Location are set side by side for a person to compare.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025"], "numbers": [{"text": "2", "evidence_id": "strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025"}], "dates": [{"text": "2018", "evidence_id": "strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025"}, {"text": "2025", "evidence_id": "strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025"}], "quote": null, "section": "by_site", "group": 0, "part": "sentence"}

event: sentence
data: {"index": 37, "text": "In Mombasa, residents have pushed back on the project's works.", "kind": "summary", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835", "strata.research.item:P156634/outlet_feeds/a230f243be70415c"], "numbers": [], "dates": [], "quote": null, "section": "by_site", "group": 1, "part": "title"}

event: sentence
data: {"index": 38, "text": "In Old Town in 2022, residents waited for disturbance allowances while \"the old pipes spill sewage all over the place\".", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"], "numbers": [], "dates": [{"text": "2022", "evidence_id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"}], "quote": null, "section": "by_site", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 39, "text": "The Kipevu wastewater plant was still under rehabilitation in the World Bank's data of January 30, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p6-s7"], "numbers": [], "dates": [{"text": "January 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p6-s7"}], "quote": null, "section": "by_site", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 40, "text": "On October 8, 2026, a civil society lobby demanded a solution to the Changamwe-Jomvu water crisis.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/b87138d428e8a344"], "numbers": [], "dates": [{"text": "October 8, 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/b87138d428e8a344"}], "quote": null, "section": "by_site", "group": 1, "part": "sentence"}

event: sentence
data: {"index": 41, "text": "Kwale's contracts were still to finish, and the project's two direct awards were a solar system for the Ukunda water supply and the Vindo booster station.", "kind": "summary", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p6-s7", "strata.tools.research_evidence:P156634@2026-11-05", "strata.research.item:P156634/procurement_notices/OP00471125", "strata.research.item:P156634/procurement_notices/OP00457686"], "numbers": [{"text": "two", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "dates": [], "quote": null, "section": "by_site", "group": 2, "part": "title"}

event: sentence
data: {"index": 42, "text": "The World Bank's report of March 12, 2026 expects its water delivery targets \"to be exceeded once Kwale contracts are complete\".", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p6-s7"], "numbers": [], "dates": [{"text": "March 12, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p6-s7"}], "quote": null, "section": "by_site", "group": 2, "part": "sentence"}

event: sentence
data: {"index": 43, "text": "The solar system for the Ukunda water supply was awarded by direct selection on September 25, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00471125"], "numbers": [], "dates": [{"text": "September 25, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00471125"}], "quote": null, "section": "by_site", "group": 2, "part": "sentence"}

event: sentence
data: {"index": 44, "text": "The Vindo booster station works were awarded by direct selection on July 20, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00457686"], "numbers": [], "dates": [{"text": "July 20, 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00457686"}], "quote": null, "section": "by_site", "group": 2, "part": "sentence"}

event: sentence
data: {"index": 45, "text": "In the north-east, Wajir's sludge treatment plant was still being built in June 2026, and the last boreholes were awarded in October 2026.", "kind": "summary", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/e25eedf42e385947", "strata.research.item:P156634/procurement_notices/OP00474946"], "numbers": [], "dates": [{"text": "June 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}, {"text": "October 2026", "evidence_id": "strata.research.item:P156634/procurement_notices/OP00474946"}], "quote": null, "section": "by_site", "group": 3, "part": "title"}

event: sentence
data: {"index": 46, "text": "Wajir's flat sandy terrain and high water table have made pit latrines unsuitable, and the new plant is about five kilometres from Wajir town.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/e25eedf42e385947"], "numbers": [{"text": "five", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}], "dates": [], "quote": null, "section": "by_site", "group": 3, "part": "sentence"}

event: sentence
data: {"index": 47, "text": "The World Bank's report of June 30, 2026 says the boreholes and sanitation facilities in Garissa and Wajir are substantially complete or nearing finalization.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40114539-p2-s4"], "numbers": [], "dates": [{"text": "June 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40114539-p2-s4"}], "quote": null, "section": "by_site", "group": 3, "part": "sentence"}

event: sentence
data: {"index": 48, "text": "The World Bank's data of January 30, 2026 count 34 community water points so far, with additional source identification and drilling works ongoing.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p5-s7"], "numbers": [{"text": "34", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p5-s7"}], "dates": [{"text": "January 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p5-s7"}], "quote": null, "section": "by_site", "group": 3, "part": "sentence"}

event: sentence
data: {"index": 49, "text": "Launching the northern agency's plan in May 2025, the Cabinet Secretary said \"the water connectivity on the ground tells a different story\".", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"], "numbers": [], "dates": [{"text": "May 2025", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}], "quote": null, "section": "by_site", "group": 3, "part": "sentence"}

event: sentence
data: {"index": 50, "text": "David Kanui said: \"We have had problems when water supply is disrupted because of power being disconnected due to unpaid bills\".", "kind": "quote", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"], "numbers": [], "dates": [], "quote": {"text": "We have had problems when water supply is disrupted because of power being disconnected due to unpaid bills", "evidence_id": "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"}, "section": "voices", "group": 0, "part": "quote"}

event: sentence
data: {"index": 51, "text": "Eric Murithi said: \"We have been dealing with high electricity bills because we are in low-lying areas and need to pump the water\".", "kind": "quote", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/df117621dfc94a93"], "numbers": [], "dates": [], "quote": {"text": "We have been dealing with high electricity bills because we are in low-lying areas and need to pump the water", "evidence_id": "strata.research.item:P156634/outlet_feeds/df117621dfc94a93"}, "section": "voices", "group": 1, "part": "quote"}

event: sentence
data: {"index": 52, "text": "Lubnar Omar said: \"The project is good but it disrupted our businesses because of the construction works\".", "kind": "quote", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"], "numbers": [], "dates": [], "quote": {"text": "The project is good but it disrupted our businesses because of the construction works", "evidence_id": "strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"}, "section": "voices", "group": 2, "part": "quote"}

event: sentence
data: {"index": 53, "text": "Eric Mugaa said: \"The Ministry has invested more than Sh12 billion in this region but the water connectivity on the ground tells a different story\".", "kind": "quote", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"], "numbers": [{"text": "12", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}], "dates": [], "quote": {"text": "The Ministry has invested more than Sh12 billion in this region but the water connectivity on the ground tells a different story", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}, "section": "voices", "group": 3, "part": "quote"}

event: sentence
data: {"index": 54, "text": "Julius Korir said: \"There is an audit report that came from the national audit office looking at the water infrastructure in the region and the verdict is that we have invested in small water pans that end up not being sustainable\".", "kind": "quote", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"], "numbers": [], "dates": [], "quote": {"text": "There is an audit report that came from the national audit office looking at the water infrastructure in the region and the verdict is that we have invested in small water pans that end up not being sustainable", "evidence_id": "strata.research.item:P156634/outlet_feeds/4f236e25b63dcc1f"}, "section": "voices", "group": 4, "part": "quote"}

event: sentence
data: {"index": 55, "text": "Ask which of the six contracts awarded in the 110 days before closing can be completed by the closing date of October 31, 2026, and which will run past it.", "kind": "advice", "evidence_ids": ["strata.tools.research_evidence:P156634@2026-11-05"], "numbers": [{"text": "six", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}, {"text": "110", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "dates": [{"text": "October 31, 2026", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "quote": null, "section": "questions", "group": 0, "part": "question"}

event: sentence
data: {"index": 56, "text": "The last award came 18 days before closing, a day after its invitation for bids was published.", "kind": "record", "evidence_ids": ["strata.tools.research_evidence:P156634@2026-11-05", "strata.research.item:P156634/procurement_notices/OP00474700", "strata.research.item:P156634/procurement_notices/OP00474946"], "numbers": [{"text": "18", "evidence_id": "strata.tools.research_evidence:P156634@2026-11-05"}], "dates": [], "quote": null, "section": "questions", "group": 0, "part": "question"}

event: sentence
data: {"index": 57, "text": "The Ukunda solar system and the Vindo booster station works were awarded by direct selection.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00471125", "strata.research.item:P156634/procurement_notices/OP00457686"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 1, "part": "question"}

event: sentence
data: {"index": 58, "text": "Ask what justification is on file for each, and whether the Ukunda solar system repeats the Baricho solar design.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/procurement_notices/OP00471125", "strata.research.item:P156634/procurement_notices/OP00457686", "strata.research.item:P156634/outlet_feeds/1daaf047c22f24eb"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 1, "part": "question"}

event: sentence
data: {"index": 59, "text": "The ministry announced the Sh4 billion Baricho works complete in June 2024.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"], "numbers": [{"text": "4", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}], "dates": [{"text": "June 2024", "evidence_id": "strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"}], "quote": null, "section": "questions", "group": 2, "part": "question"}

event: sentence
data: {"index": 60, "text": "Ask whether the final account is closed and the taking-over certificate has been issued.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/79bb66e7e1850e49"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 2, "part": "question"}

event: sentence
data: {"index": 61, "text": "The plant was expected to be done in 2022 and was still under rehabilitation on January 30, 2026.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b", "strata.research.item:P156634/isr_narrative/40091292-p6-s7"], "numbers": [], "dates": [{"text": "2022", "evidence_id": "strata.research.item:P156634/outlet_feeds/24d1ca8a593f492b"}, {"text": "January 30, 2026", "evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p6-s7"}], "quote": null, "section": "questions", "group": 3, "part": "question"}

event: sentence
data: {"index": 62, "text": "Ask what extensions of time were granted, and whether the plant will be taken over before closing.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p6-s7", "strata.tools.research_evidence:P156634@2026-11-05"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 3, "part": "question"}

event: sentence
data: {"index": 63, "text": "With the plant at 64% in June 2026, ask whether it can be commissioned by the closing date, and if not, under which financing it finishes.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/e25eedf42e385947", "strata.tools.research_evidence:P156634@2026-11-05"], "numbers": [{"text": "64", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}], "dates": [{"text": "June 2026", "evidence_id": "strata.research.item:P156634/outlet_feeds/e25eedf42e385947"}], "quote": null, "section": "questions", "group": 4, "part": "question"}

event: sentence
data: {"index": 64, "text": "Ask whether the Old Town disturbance allowances and the water bowsers agreed against dust are in the works contracts, and what has been paid.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/dc25aeb34cfaa835"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 5, "part": "question"}

event: sentence
data: {"index": 65, "text": "People Daily reported that the Auditor General named the coast agency the most incompetent agency in the water sector, and the Governor of Taita Taveta called for the agency to be disbanded.", "kind": "record", "evidence_ids": ["strata.research.item:P156634/outlet_feeds/57eebce979ca2f45", "strata.research.item:P156634/outlet_feeds/c1f6a8f12b71bd4a"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 6, "part": "question"}

event: sentence
data: {"index": 66, "text": "Ask how the coast agency will finish the works contracts still under way within the remaining project period.", "kind": "advice", "evidence_ids": ["strata.research.item:P156634/isr_narrative/40091292-p2-s4", "strata.research.item:P156634/outlet_feeds/57eebce979ca2f45", "strata.research.item:P156634/outlet_feeds/c1f6a8f12b71bd4a"], "numbers": [], "dates": [], "quote": null, "section": "questions", "group": 6, "part": "question"}

event: sentence
