data: {"id": "strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.research.item:P156634/sentinel2_mosaic/200577-2018-2025", "public_from": "2025-12-31", "source": {"key": "sentinel2_mosaic", "label": "Sentinel-2 cloudless mosaics", "kind": "satellite", "license": "Sentinel-2 cloudless by EOX IT Services GmbH, contains modified Copernicus Sentinel data, CC BY-NC-SA 4.0.", "url_of_source": "https://s2maps.eu"}, "kind": "satellite", "title": "Sentinel-2 cloudless mosaics of 2018 and 2025 around Baricho Sub-Location", "text": "Two grids of 3 by 3 Sentinel-2 cloudless tiles at zoom 15, centred on Baricho Sub-Location (-3.1, 39.78333): the 2018 mosaic and the 2025 mosaic. Prism reads no pixels; the grids are for a person to compare.", "url": "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16666/20005.jpg", "published": null, "date_known": false, "observed": "2025-12-31", "location": {"geo_loc_id": "200577", "name": "Baricho Sub-Location", "latitude": -3.1, "longitude": 39.78333}, "image_urls": [["https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16665/20004.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16665/20005.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16665/20006.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16666/20004.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16666/20005.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16666/20006.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16667/20004.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16667/20005.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2018_3857/default/g/15/16667/20006.jpg"], ["https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16665/20004.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16665/20005.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16665/20006.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16666/20004.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16666/20005.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16666/20006.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16667/20004.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16667/20005.jpg", "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/15/16667/20006.jpg"]], "author": "EOX IT Services GmbH", "read_on": "2026-11-05", "team": null, "notice": null}, "highlights": []}

