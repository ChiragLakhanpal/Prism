data: {"id": "strata.research.item:P156634/isr_narrative/40091292-p5-s7", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.research.item:P156634/isr_narrative/40091292-p5-s7", "public_from": "2026-03-12", "source": {"key": "isr_narrative", "label": "World Bank project reports", "kind": "bank_report", "license": "The World Bank: Documents & Reports (documents.worldbank.org). License: CC BY 4.0.", "url_of_source": "https://documents.worldbank.org/en/publication/documents-reports/documentlist?projid=P156634&docty_exact=Implementation+Status+and+Results+Report"}, "kind": "bank_report", "title": "ISR ISR07091, March 12, 2026: Results indicators, comments on achieving targets, page 5", "text": "Component 2: Expansion of water supply and sanitation services in underserved northeastern counties of Kenya (US$33 of which IDA-SUF US$30 million). Baseline Actual (Previous) Actual (Current) Closing Period Indicator Name Value Month/Year Value Date Value Date Value Month/Year Improved community water 0.00 Apr/2017 28.00 30-Jan-2026 28.00 30-Jan-2026 22.00 Oct/2026 points constructed or Comments on NWWDA has constructed 8 communal water points, and is planning an additional 7. Wajir rehabilitated under the achieving targets has constructed 2, and Garissa has constructed 24. This gives a total of 34 so far. project (Number) New water supplied to 0.00 Apr/2017 3,830.00 30-Jan-2026 3,830.00 30-Jan-2026 3,200.00 Oct/2026 northeastern WSPs under the Comments on Additional source identification and drilling works ongoing project (cubic meters/day) achieving targets (Number) Gender action plans 0.00 Apr/2017 2.00 30-Jan-2026 2.00 30-Jan-2026 2.00 Oct/2026 developed and under Comments on Completed implementation. (Number) achieving targets 0.00 Jul/2016 13,352.00 30-Jan-2026 13,352.00 30-Jan-2026 13,650.00 Oct/2026 People provided with access Comments on Most facilities in Wajir and Garissa complete and in use. to improved shared achieving targets sanitation facilities (Number) Component 2: Expansion of water supply and sanitation services in underserved northeastern counties of Kenya (US$33 million of which IDA-SUF US$30 million). Baseline Actual (Previous) Actual (Current) Closing Period Indicator Name Value Month/Year Value Date Value Date Value Month/Year Piped household water 0.00 Apr/2017 15,500.00 30-Jan-2026 15,500.00 30-Jan-2026 15,500.00 Oct/2026 connections that are Comments on Contract complete. All previous existing connections benefitting. benefiting from rehabilitation achieving targets works undertaken under the project. (Number) New piped household water 0.00 Apr/2017 4,600.00 30-Jan-2026 4,600.00 30-Jan-2026 11,900.00 Oct/2026 connections under the Comments on Water distribution contracts complete. Target exceeded. project.", "url": "https://documents.worldbank.org/curated/en/099031226003019207/pdf/P156634-4691aab6-8be2-47be-a151-186b5d20a1b3.pdf#page=5", "published": "2026-03-12", "date_known": true, "observed": null, "location": null, "image_urls": [], "author": "World Bank", "read_on": "2026-11-05", "team": null, "notice": null}, "highlights": []}

