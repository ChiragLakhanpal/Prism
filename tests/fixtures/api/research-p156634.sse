data: {"id": "strata.research.item:P156634/procurement_notices/OP00474696", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.research.item:P156634/procurement_notices/OP00474696", "public_from": "2026-10-12", "source": {"key": "procurement_notices", "label": "World Bank procurement notices", "kind": "procurement", "license": "The World Bank: Procurement Notices: Systematic Tracking of Exchanges in Procurement (STEP), from search.worldbank.org/api/v2/procnotices. License: CC BY 4.0.", "url_of_source": "https://projects.worldbank.org/en/projects-operations/procurement?projectId=P156634"}, "kind": "procurement", "title": "Contract Award OP00474696, KE-NWWDA-541062-CW-RFQ (Request for Quotations): Equipping of Exploratory Boreholes project- Lot 3- Qaras Water Supply", "text": "Contract Award Project: P156634-Water and Sanitation Development Project Loan/Credit/TF Info: IDA-60300 Bid/Contract Reference No: KE-NWWDA-541062-CW-RFQ Procurement Method: RFQ-Request for Quotations Scope of Contract: Borehole Equipping with Solar , Rising Main 4.1Km, HDPE PN 10, OD 125mm Distribution mains of 63mm- 110 PN8 OD,3.2 KM, Elevated Steel Tank 100m3 and associated Civil Works Notice Version No: 0 Date Notification of Award Issued (YYYY/MM/DD) 2026/05/04 Duration of Contract 90 Day(s) Awarded Bidder(s): YATICO SUPPLIES AND CONSTRUCTION LIMITED (1134841) Po Box 488-70100 Garissa Country: Kenya Bid Price at Opening KES 38896151.80 Evaluated Bid Price KES 38896151.80 Signed Contract price KES 38896151.80", "url": "https://projects.worldbank.org/en/projects-operations/procurement-detail/OP00474696", "published": "2026-10-12", "date_known": true, "observed": null, "location": null, "image_urls": [], "author": "World Bank procurement notices (STEP)", "read_on": "2026-11-05", "team": null, "notice": {"notice_date": "2026-10-12", "award_notification_date": "2026-05-04"}}, "highlights": []}

