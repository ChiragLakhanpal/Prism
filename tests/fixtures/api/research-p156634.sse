data: {"id": "strata.research.item:P156634/procurement_notices/OP00474700", "kind": "record", "tool": "research_evidence", "stratum": "What", "short_name": null, "row": {"evidence_id": "strata.research.item:P156634/procurement_notices/OP00474700", "public_from": "2026-10-12", "source": {"key": "procurement_notices", "label": "World Bank procurement notices", "kind": "procurement", "license": "The World Bank: Procurement Notices: Systematic Tracking of Exchanges in Procurement (STEP), from search.worldbank.org/api/v2/procnotices. License: CC BY 4.0.", "url_of_source": "https://projects.worldbank.org/en/projects-operations/procurement?projectId=P156634"}, "kind": "procurement", "title": "Invitation for Bids OP00474700, KE-NWWDA-541055-CW-RFB (Request for Bids): Equipping of Exploratory Boreholes Project-Lot 1- Sarman - Tarbaj Water Supply", "text": "REQUEST FOR BIDS (RFB) Country: Kenya Project: WATER AND SANITATION DEVELOPMENT PROJECT Credit No.: IDA-60300 Ref: KE-NWWDA-541055-CW-RFB RFB Title: Equipping of Exploratory Boreholes Project-Lot 1- Sarman - Tarbaj Water Supply County Contract No. KE. KE-NWWDA-541055-CW-RFB The Northern Water Works Development Agency has received financing from the World Bank toward the cost of the Water and Sanitation Development Project , and intends to apply part of the proceeds toward payments under the contract for Equipping of Exploratory Boreholes Project-Lot 1- Sarman - Tarbaj Water Supply , Contract No. KE-NWWDA-541055-CW-RFB. The Northern Water Works Development Agency now invites sealed bids from eligible bidders for Equipping of Exploratory Boreholes Project-Lot 1- Sarman - Tarbaj Water Supply , Contract No. KE-NWWDA-541055-CW-RFB , as detailed below:, , 160/140 OD, PN10-16, and associated civil works Borehole Equipping with Solar. HDPE Rising Main 40KM , 160/140 OD, PN10-16, and associated civil works Bidding will be conducted through the National Competitive Bidding procurement using a Request for Bids as specified in the World Bank’s “Procurement Regulations” for IPF Borrower and is open to all eligible Bidders as defined in the procurement Regulations. Interested eligible Bidders may obtain further information from Northern Water Works Development Agency, Procurement office (A3 Ground floor), email [contact removed] and inspect the bidding documents during office hours 00900 to 1600 hours at the address given below The bidding document in English may be downloaded free of charge from our website www.nwwda.go.ke or www.tenders.go.ke - Public Procurement Information Portal Addendum/Clarifications will also be posted in the NWWDA website immediately they become available Bids must be delivered to the address below on or before the 12th May 2026 at 11.00 am. Electronic bidding will not be permitted. Late bids will be rejected. Bids will be publicly opened in the presence of the bidders’ designated representatives and anyone who choose to attend at the address below at Conference Room, at 11.30 am on 12th May 2026. All Bids shall be accompanied by a Bid Security (Unconditional Bank guarantee) of Kshs. 2,000,000.00 (Two Million only) The address referred to above is: Chief Executive Officer Northern Water Works Development Agency Maji House, Kismayu Road P.O. Box 495 – 70100 GARISSA, KENYA Fax: [contact removed] [contact removed] Website: www.nwwda.go.ke", "url": "https://projects.worldbank.org/en/projects-operations/procurement-detail/OP00474700", "published": "2026-10-12", "date_known": true, "observed": null, "location": null, "image_urls": [], "author": "World Bank procurement notices (STEP)", "read_on": "2026-11-05", "team": null, "notice": {"notice_date": "2026-10-12", "submission_date": "2026-10-12"}}, "highlights": []}

