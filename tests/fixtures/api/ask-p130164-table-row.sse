data: {"id": "strata.gold.passage:31525018/v1/55", "kind": "passage", "tool": "search_passages", "stratum": "Why", "short_name": "ICR", "row": {"evidence_id": "strata.gold.passage:31525018/v1/55", "public_from": "2019-11-02", "source": {"document_type": "Implementation Completion and Results Report", "project_id": "P130164", "project_name": "Rajasthan Road Sector Modernization Project", "document_id": "31525018", "document_date": "2019-10-10", "report_number": "ICR4803", "version": 1, "section_path": "III.B", "paragraph": "55", "paragraph_numbered": true, "pdf_page": 23, "pdf_pages": 66, "pdf_url": "http://documents.worldbank.org/curated/en/258481572631321132/pdf/India-Rajasthan-Road-Sector-Modernization-Project.pdf", "doc_key": "icr-2019-10-10", "notice_id": null, "notice_url": null}, "passage_id": "31525018/v1/55", "document_id": "31525018", "document_type": "Implementation Completion and Results Report", "project_id": "P130164", "version": 1, "section_path": "III.B", "paragraph": "55", "paragraph_numbered": true, "part": 1, "parts": 1, "pdf_page": 23, "last_pdf_page": 23, "printed_page": "19 of 62", "language": "en", "parse_route": "A", "kind": "paragraph", "route": "published_text", "scanned": false, "table_title": null, "table_row": null, "cells": null, "notice_id": null, "header": "ICR, P130164, India, roads, III.B, ¶55, p.23", "text": "55. To avoid cost and time overruns and contract administration issues, forest and other administrative clearances should have been in place prior to awarding contracts. Some of the road works were dropped due to land and/or forest clearance issues (cf. below).", "rank": 8, "score": 0.02837}, "highlights": [{"sentence": 1, "start": 72, "end": 168}]}

