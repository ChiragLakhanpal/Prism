event: sentence
data: {"index": 0, "text": "The middle half of the 49 comparable packages took 3.3 to 7.9 months from notice to signed contract, and the middle one took 4.4.", "kind": "record", "evidence_ids": ["strata.tools.find_comparables:KE-NWWDA-541055-CW-RFB@2026-10-22"], "numbers": [{"text": "49", "evidence_id": "strata.tools.find_comparables:KE-NWWDA-541055-CW-RFB@2026-10-22"}, {"text": "3.3", "evidence_id": "strata.tools.find_comparables:KE-NWWDA-541055-CW-RFB@2026-10-22"}, {"text": "7.9", "evidence_id": "strata.tools.find_comparables:KE-NWWDA-541055-CW-RFB@2026-10-22"}, {"text": "4.4", "evidence_id": "strata.tools.find_comparables:KE-NWWDA-541055-CW-RFB@2026-10-22"}], "dates": [], "quote": null}

