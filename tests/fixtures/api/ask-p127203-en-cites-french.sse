event: sentence
data: {"index": 0, "text": "The completion report ties the late bidding documents and procurement processes to gaps in the project's design.", "kind": "summary", "evidence_ids": ["strata.gold.passage:33407968/v1/60"], "numbers": [], "dates": [], "quote": null}

event: sentence
data: {"index": 1, "text": "In its own words, \"des retards ont eu lieu dans la préparation des documents d’appels d’offres et des processus de passations des marchés\".", "kind": "quote", "evidence_ids": ["strata.gold.passage:33407968/v1/60"], "numbers": [], "dates": [], "quote": {"text": "des retards ont eu lieu dans la préparation des documents d’appels d’offres et des processus de passations des marchés", "evidence_id": "strata.gold.passage:33407968/v1/60"}}

