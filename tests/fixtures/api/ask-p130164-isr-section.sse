event: sentence
data: {"index": 0, "text": "The completion report says the works contract estimates should have been based on the market rate, because \"108 of 328 cases had to go through rebidding\".", "kind": "quote", "evidence_ids": ["strata.gold.passage:31525018/v1/54"], "numbers": [{"text": "108", "evidence_id": "strata.gold.passage:31525018/v1/54"}, {"text": "328", "evidence_id": "strata.gold.passage:31525018/v1/54"}], "dates": [], "quote": {"text": "108 of 328 cases had to go through rebidding", "evidence_id": "strata.gold.passage:31525018/v1/54"}}

event: sentence
data: {"index": 1, "text": "It also says \"forest and other administrative clearances should have been in place prior to awarding contracts\".", "kind": "quote", "evidence_ids": ["strata.gold.passage:31525018/v1/55"], "numbers": [], "dates": [], "quote": {"text": "forest and other administrative clearances should have been in place prior to awarding contracts", "evidence_id": "strata.gold.passage:31525018/v1/55"}}

event: sentence
data: {"index": 2, "text": "The completion report is dated October 10, 2019.", "kind": "record", "evidence_ids": ["strata.gold.passage:31525018/v1/54"], "numbers": [], "dates": [{"text": "October 10, 2019", "evidence_id": "strata.gold.passage:31525018/v1/54"}], "quote": null}

event: sentence
data: {"index": 3, "text": "The first status report's table for the share of rural people with an all-season road reads \"Percentage Value 67.00 67.00 80.00\", and the completion report tracked the same indicator.", "kind": "quote", "evidence_ids": ["strata.gold.passage:19095337/v1/s4", "strata.gold.passage:31525018/v1/s38"], "numbers": [{"text": "67.00", "evidence_id": "strata.gold.passage:19095337/v1/s4"}, {"text": "67.00", "evidence_id": "strata.gold.passage:19095337/v1/s4"}, {"text": "80.00", "evidence_id": "strata.gold.passage:19095337/v1/s4"}], "dates": [], "quote": {"text": "Percentage Value 67.00 67.00 80.00", "evidence_id": "strata.gold.passage:19095337/v1/s4"}}

