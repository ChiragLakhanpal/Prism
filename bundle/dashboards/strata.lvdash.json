{
  "datasets": [
    {
      "name": "readiness_headline",
      "displayName": "The day's headline",
      "queryLines": [
        "WITH chosen AS (\n",
        "  SELECT measured_on, written_at\n",
        "  FROM strata.ops.readiness_snapshot\n",
        "  WHERE measured_on <= :measure_date\n",
        "  ORDER BY measured_on DESC, written_at DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT s.measured_on, s.text AS headline\n",
        "FROM strata.ops.readiness_snapshot AS s\n",
        "JOIN chosen AS c ON c.measured_on = s.measured_on AND c.written_at = s.written_at\n",
        "WHERE s.part = 'headline'\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "award_rows_by_year",
      "displayName": "Contract-award rows per fiscal year",
      "queryLines": [
        "SELECT\n",
        "  fiscal_year,\n",
        "  concat('FY', right(CAST(fiscal_year AS STRING), 2)) AS fiscal_year_label,\n",
        "  CASE source\n",
        "    WHEN 'awards' THEN 'Awards since FY2020'\n",
        "    WHEN 'awards_fy2001_2016' THEN 'Awards, FY2001–16'\n",
        "    ELSE 'Award notices, FY2017–19'\n",
        "  END AS dataset,\n",
        "  count(*) AS award_rows\n",
        "FROM strata.gold.contract\n",
        "WHERE public_from <= :measure_date AND fiscal_year IS NOT NULL\n",
        "GROUP BY fiscal_year, source\n",
        "ORDER BY fiscal_year, dataset\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "rows_by_year",
      "displayName": "Rows per fiscal year, by source",
      "queryLines": [
        "WITH counted AS (\n",
        "  SELECT\n",
        "    CASE source\n",
        "      WHEN 'awards' THEN 'Awards since FY2020'\n",
        "      WHEN 'awards_fy2001_2016' THEN 'Awards, FY2001–16'\n",
        "      ELSE 'Award notices, FY2017–19'\n",
        "    END AS source,\n",
        "    fiscal_year\n",
        "  FROM strata.gold.contract\n",
        "  WHERE public_from <= :measure_date\n",
        "  UNION ALL\n",
        "  SELECT 'Procurement notices', fiscal_year FROM strata.silver.notices WHERE public_from <= :measure_date\n",
        "  UNION ALL\n",
        "  SELECT 'Projects', approval_fiscal_year FROM strata.gold.project WHERE public_from <= :measure_date\n",
        "  UNION ALL\n",
        "  SELECT 'IEG ratings', evaluation_fy FROM strata.gold.ieg_rating WHERE public_from <= :measure_date\n",
        ")\n",
        "SELECT\n",
        "  source,\n",
        "  fiscal_year,\n",
        "  concat('FY', right(CAST(fiscal_year AS STRING), 2)) AS fiscal_year_label,\n",
        "  count(*) AS source_rows\n",
        "FROM counted\n",
        "WHERE fiscal_year IS NOT NULL\n",
        "GROUP BY source, fiscal_year\n",
        "ORDER BY source, fiscal_year\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "readiness_links",
      "displayName": "Shares of rows that link",
      "queryLines": [
        "WITH chosen AS (\n",
        "  SELECT measured_on, written_at\n",
        "  FROM strata.ops.readiness_snapshot\n",
        "  WHERE measured_on <= :measure_date\n",
        "  ORDER BY measured_on DESC, written_at DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT s.position, s.label AS link, s.share_percent, s.count, s.denominator\n",
        "FROM strata.ops.readiness_snapshot AS s\n",
        "JOIN chosen AS c ON c.measured_on = s.measured_on AND c.written_at = s.written_at\n",
        "WHERE s.part = 'link' AND s.share_percent IS NOT NULL\n",
        "ORDER BY s.position\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "readiness_routes",
      "displayName": "Shares of pages read well",
      "queryLines": [
        "WITH chosen AS (\n",
        "  SELECT measured_on, written_at\n",
        "  FROM strata.ops.readiness_snapshot\n",
        "  WHERE measured_on <= :measure_date\n",
        "  ORDER BY measured_on DESC, written_at DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT s.position, s.label AS route, s.share_percent, s.count, s.denominator\n",
        "FROM strata.ops.readiness_snapshot AS s\n",
        "JOIN chosen AS c ON c.measured_on = s.measured_on AND c.written_at = s.written_at\n",
        "WHERE s.part = 'route'\n",
        "ORDER BY s.position\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "readiness_sources",
      "displayName": "Freshness and link counts",
      "queryLines": [
        "WITH chosen AS (\n",
        "  SELECT measured_on, written_at\n",
        "  FROM strata.ops.readiness_snapshot\n",
        "  WHERE measured_on <= :measure_date\n",
        "  ORDER BY measured_on DESC, written_at DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT\n",
        "  s.position,\n",
        "  s.label AS source,\n",
        "  s.latest_data,\n",
        "  s.updates,\n",
        "  s.days_late,\n",
        "  CASE WHEN s.part = 'source' THEN s.text END AS linked,\n",
        "  s.status\n",
        "FROM strata.ops.readiness_snapshot AS s\n",
        "JOIN chosen AS c ON c.measured_on = s.measured_on AND c.written_at = s.written_at\n",
        "WHERE s.part IN ('source', 'gap')\n",
        "ORDER BY s.position\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "readiness_fixes",
      "displayName": "Fixes",
      "queryLines": [
        "WITH chosen AS (\n",
        "  SELECT measured_on, written_at\n",
        "  FROM strata.ops.readiness_snapshot\n",
        "  WHERE measured_on <= :measure_date\n",
        "  ORDER BY measured_on DESC, written_at DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT s.position AS rank, s.text AS fix, s.projects\n",
        "FROM strata.ops.readiness_snapshot AS s\n",
        "JOIN chosen AS c ON c.measured_on = s.measured_on AND c.written_at = s.written_at\n",
        "WHERE s.part = 'fix'\n",
        "ORDER BY s.position\n"
      ],
      "parameters": [
        {
          "displayName": "measure_date",
          "keyword": "measure_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    }
  ],
